<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up - TRENDORA</title>

    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
    />
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/css/signup.css" />
  </head>

  <body>
    <div class="auth-topbar">
      <a href="/admin" class="topbar-logo">
        <img src="/img/brand-logo.png" alt="TRENDORA" class="logo-img" />
        <span class="logo-text">TRENDORA</span>
      </a>
      <a href="/admin" class="topbar-home">
        <i class="bi bi-house-door-fill"></i>
        Home
      </a>
    </div>

    <div class="signup-page">
      <div class="signup-container">
        <div class="signup-left">
          <div class="branding-content">
            <h1 class="brand-title">TRENDORA</h1>
            <p class="brand-subtitle">Fashion Admin Panel</p>
            <p class="brand-description">
              Join us and start managing your fashion empire with style and
              elegance.
            </p>
            <div class="decorative-line"></div>
          </div>
        </div>

        <div class="signup-right">
          <div class="form-wrapper">
            <div class="form-header">
              <h2>Create Account</h2>
              <p>Sign up to get started</p>
            </div>

            <div class="image-preview-section">
              <div class="image-preview" id="imagePreview">
                <img src="/img/default.jpg" alt="Preview" id="previewImg" />
              </div>
            </div>

            <form
              id="signupForm"
              class="signup-form"
              action="/admin/signup"
              method="POST"
              enctype="multipart/form-data"
            >
              <div class="form-group">
                <input
                  type="file"
                  id="memberImage"
                  name="memberImage"
                  class="image-input"
                  accept="image/jpg,image/jpeg,image/png"
                />
                <label for="memberImage" class="upload-btn">
                  <i class="bi bi-camera-fill"></i>
                  <span class="upload-text">Choose Image</span>
                </label>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="memberNick">
                    <i class="bi bi-person-circle"></i>
                    Username *
                  </label>
                  <input
                    type="text"
                    id="memberNick"
                    name="memberNick"
                    class="form-control"
                    placeholder="Your username"
                  />
                </div>

                <div class="form-group">
                  <label for="memberEmail">
                    <i class="bi bi-envelope-fill"></i>
                    Email *
                  </label>
                  <input
                    type="email"
                    id="memberEmail"
                    name="memberEmail"
                    class="form-control"
                    placeholder="Your email"
                  />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="memberPhone">
                    <i class="bi bi-telephone-fill"></i>
                    Phone *
                  </label>
                  <input
                    type="tel"
                    id="memberPhone"
                    name="memberPhone"
                    class="form-control"
                    placeholder="Phone number"
                  />
                </div>

                <div class="form-group">
                  <label for="memberPassword">
                    <i class="bi bi-lock-fill"></i>
                    Password *
                  </label>
                  <input
                    type="password"
                    id="memberPassword"
                    name="memberPassword"
                    class="form-control"
                    placeholder="Create password"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="confirmPassword">
                  <i class="bi bi-lock-fill"></i>
                  Confirm Password *
                </label>
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  class="form-control"
                  placeholder="Confirm your password"
                />
              </div>

              <div class="form-group">
                <label for="memberAddress">
                  <i class="bi bi-geo-alt-fill"></i>
                  Address
                </label>
                <input
                  type="text"
                  id="memberAddress"
                  name="memberAddress"
                  class="form-control"
                  placeholder="Your address (optional)"
                />
              </div>

              <!-- Hidden memberType -->
              <input type="hidden" name="memberType" value="ADMIN" />

              <button type="submit" class="btn-submit">
                <span>Create Account</span>
                <i class="bi bi-arrow-right-circle-fill"></i>
              </button>

              <div class="form-footer">
                <p>
                  Already have an account?
                  <a href="/admin/login">Sign in here</a>
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/signup.js"></script>

    <%- include('includes/auth-footer') %>
  </body>
</html>
