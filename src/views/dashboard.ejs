<%- include('includes/header') %>
<link rel="stylesheet" href="/css/dashboard.css" />

<body>
  <div class="dashboard-page">
    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar">
      <div class="logo">
        <!-- Brand logo on top -->
        <!-- <img src="/img/brand-logo.png" alt="TRENDORA Logo" /> -->
      </div>

      <nav>
        <a href="/admin/dashboard"
          ><i class="bi bi-house-door-fill"></i> Dashboard</a
        >
        <a href="/admin/product/all"><i class="bi bi-bag-fill"></i> Products</a>
        <a href="/admin/user/all"><i class="bi bi-people-fill"></i> Users</a>
        <a href="/admin/order/all"
          ><i class="bi bi-receipt-cutoff"></i> Orders</a
        >
        <a href="/admin/profile"><i class="bi bi-person-circle"></i> Profile</a>
      </nav>

      <a href="/admin/logout" class="logout"
        ><i class="bi bi-box-arrow-right"></i> Logout</a
      >
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
      <div class="welcome-header">
        <h2>Welcome back, <%= member.memberNick %>!</h2>
        <p>Manage your fashion store efficiently</p>
      </div>

      <div class="dashboard-grid">
        <!-- Products Card -->
        <a href="/admin/product/all" class="dashboard-card products">
          <div class="card-bg"></div>
          <div class="card-content">
            <div class="card-icon">
              <i class="bi bi-bag-heart-fill"></i>
            </div>
            <h3 class="card-title">Products</h3>
            <p class="card-desc">Manage your inventory</p>
          </div>
        </a>

        <!-- Users Card -->
        <a href="/admin/user/all" class="dashboard-card users">
          <div class="card-bg"></div>
          <div class="card-content">
            <div class="card-icon">
              <i class="bi bi-people-fill"></i>
            </div>
            <h3 class="card-title">Users</h3>
            <p class="card-desc">Manage customers</p>
          </div>
        </a>

        <!-- Orders Card -->
        <a href="/admin/order/all" class="dashboard-card orders">
          <div class="card-bg"></div>
          <div class="card-content">
            <div class="card-icon">
              <i class="bi bi-receipt-cutoff"></i>
            </div>
            <h3 class="card-title">Orders</h3>
            <p class="card-desc">Track transactions</p>
          </div>
        </a>

        <!-- Profile Card -->
        <a href="/admin/profile" class="dashboard-card profile">
          <div class="card-bg"></div>
          <div class="card-content">
            <div class="card-icon">
              <i class="bi bi-person-circle"></i>
            </div>
            <h3 class="card-title">Profile</h3>
            <p class="card-desc">Admin account settings</p>
          </div>
        </a>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
  <script src="/js/dashboard.js"></script>
</body>

<%- include('includes/footer') %>
