<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TRENDORA - Fashion Admin Panel</title>

    <link
      rel="icon"
      type="image/png"
      href="/img/brand-logo.png"
      class="Favicon-main"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Poppins:wght@300;400;500;600;700&family=Dancing+Script:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
    />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" type="text/css" href="/css/main.css" />
  </head>

  <body>
    <nav class="main-navbar">
      <div class="container-fluid">
        <div class="navbar-wrapper">
          <a href="/admin" class="navbar-logo">
            <img src="/img/brand-logo.png" alt="TRENDORA" class="logo-image" />
          </a>

          <div class="navbar-links">
            <a href="/admin" class="nav-link-item">Home</a>

            <% if (typeof member !== 'undefined' && member) { %>
            <!-- Logged in -->
            <a href="/admin/dashboard" class="nav-link-item">Dashboard</a>
            <a href="/admin/profile" class="nav-link-item">Profile</a>
            <a
              href="/admin/logout"
              class="nav-link-item nav-link-logout"
              onclick="return confirm('Do you want to logout?')"
              >Logout</a
            >
            <% } else { %>
            <!-- Guest -->
            <a href="/admin/login" class="nav-link-item">Login</a>
            <a href="/admin/signup" class="nav-link-item nav-link-signup"
              >Sign Up</a
            >
            <% } %>
          </div>

          <button class="mobile-menu-toggle" id="mobileToggle">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <a href="/admin" class="mobile-link">Home</a>

      <% if (typeof member !== 'undefined' && member) { %>
      <a href="/admin/dashboard" class="mobile-link">Dashboard</a>
      <a href="/admin/profile" class="mobile-link">Profile</a>
      <a
        href="/admin/logout"
        class="mobile-link"
        onclick="return confirm('Do you want to logout?')"
        >Logout</a
      >
      <% } else { %>
      <a href="/admin/login" class="mobile-link">Login</a>
      <a href="/admin/signup" class="mobile-link">Sign Up</a>
      <% } %>
    </div>

    <script>
      // Mobile Menu Toggle
      $(document).ready(function () {
        $("#mobileToggle").click(function () {
          $(this).toggleClass("active");
          $("#mobileMenu").toggleClass("active");
        });

        $(".mobile-link").click(function () {
          $("#mobileToggle").removeClass("active");
          $("#mobileMenu").removeClass("active");
        });
      });
    </script>
  </body>
</html>
